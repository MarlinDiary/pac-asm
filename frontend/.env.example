# OpenAI API Configuration
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Auth.js GitHub provider
AUTH_GITHUB_ID=your_github_client_id
AUTH_GITHUB_SECRET=your_github_client_secret

# Auth.js session encryption secret (use `openssl rand -base64 32` to generate)
AUTH_SECRET=replace_with_generated_secret

# Backend API endpoint (server-side only)
BACKEND_API_BASE_URL=http://localhost:4000
